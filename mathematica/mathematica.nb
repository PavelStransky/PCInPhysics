75e649e034e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eq", "=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"X", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"H", "[", 
         RowBox[{"p", ",", "x"}], "]"}], ",", "p"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"P", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"H", "[", 
          RowBox[{"p", ",", "x"}], "]"}], ",", "x"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"X", "[", "0", "]"}], "\[Equal]", "x0"}], ",", 
     RowBox[{
      RowBox[{"P", "[", "0", "]"}], "\[Equal]", "p0"}]}], "}"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      RowBox[{"X", "[", "t", "]"}]}], ",", 
     RowBox[{"p", "\[Rule]", 
      RowBox[{"P", "[", "t", "]"}]}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.7028945194015217`*^9, 3.702894649821488*^9}, {
  3.702894860034689*^9, 3.702894880922187*^9}, {3.702894934666525*^9, 
  3.7028949355533285`*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"731f5cc0-2be4-429d-879c-ddffb6fc2459"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["X", "\[Prime]",
      MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
    RowBox[{"P", "[", "t", "]"}]}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox["P", "\[Prime]",
      MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
    RowBox[{
     RowBox[{"-", "4"}], " ", 
     SuperscriptBox[
      RowBox[{"X", "[", "t", "]"}], "3"]}]}], ",", 
   RowBox[{
    RowBox[{"X", "[", "0", "]"}], "\[Equal]", "x0"}], ",", 
   RowBox[{
    RowBox[{"P", "[", "0", "]"}], "\[Equal]", "p0"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.7028948828198614`*^9, 3.7028949365705523`*^9}, 
   3.7028965387867827`*^9, {3.7352744442258983`*^9, 3.735274472906293*^9}, 
   3.735275598163208*^9, {3.7982799306606503`*^9, 3.7982799344972763`*^9}, 
