Cell[BoxData[
 RowBox[{
  RowBox[{"H", "[", 
   RowBox[{"p_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    SuperscriptBox["p", "2"], "2"], "+", 
   SuperscriptBox["x", "4"]}]}]], "Input",
 CellChangeTimes->{{3.7028943252082677`*^9, 3.7028943275319157`*^9}, {
