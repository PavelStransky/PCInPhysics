Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], "/.", " ", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
             RowBox[{"eta", " ", 
              RowBox[{
               RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
             RowBox[{
              SuperscriptBox["omega", "2"], " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"x", "[", "t", "]"}], "]"}]}]}], "==", 
            RowBox[{"a", " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"omega0", " ", "t"}], "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"x", "'"}], "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
         RowBox[{"x", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "200"}], "}"}]}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "200"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", "\"\<\[Theta](t)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", "Thick"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eta", ",", "0.5", ",", "\"\<tlumen\[IAcute] \[Eta]\>\""}], 
      "}"}], ",", "0", ",", "2", ",", "0.05"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
